{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directory-command-centre.example/schema/portfolio-v2.json",
  "title": "Directory Command Centre portfolio",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "portfolio", "sites"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "generatedAt": {"type": "string", "format": "date"},
    "portfolio": {"type": "object", "required": ["name", "analyticsPeriod", "visitorScope"]},
    "sites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/site"}}
  },
  "$defs": {
    "state": {"enum": ["verified", "unavailable", "not_connected", "pending_period", "stale", "failed_collection"]},
    "metric": {
      "type": "object",
      "required": ["state", "source", "asOf", "freshness"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "source": {"type": "string", "minLength": 1}, "asOf": {"type": ["string", "null"]}, "freshness": {"type": "string"}},
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": ["id", "slug", "name", "url", "decision", "status", "isNew", "metrics", "readiness"],
      "properties": {
        "id": {"type": "string", "pattern": "^site-[a-z0-9-]+$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "url": {"type": "string", "pattern": "^https://"},
        "metrics": {"type": "object", "required": ["traffic", "seo", "revenue", "listings", "content"], "additionalProperties": {"$ref": "#/$defs/metric"}}
      }
    }
  }
}
